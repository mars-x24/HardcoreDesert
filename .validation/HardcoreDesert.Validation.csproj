<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AssemblyName>HardcoreDesert.Validation</AssemblyName>
    <RootNamespace>AtomicTorch.CBND.CoreMod</RootNamespace>
    <ModRoot>$(MSBuildThisFileDirectory)..\</ModRoot>
    <CoreRoot>$(MSBuildThisFileDirectory)..\..\Core.cpk\</CoreRoot>
    <GameApiRoot>$(MSBuildThisFileDirectory)..\..\CryoFall.Mod.Sdk\LibsGameApi\</GameApiRoot>
    <Configurations>Debug;Release;Debug_LibsAsProjects</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <!-- This project validates sources only. Its DLL is not a deployable CryoFall mod. -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2020.1.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.3" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.37" />
    <PackageReference Include="Noesis.GUI.Extensions" Version="3.0.21" />
    <Reference Include="AtomicTorch.CBND.GameApi.WPF" HintPath="$(GameApiRoot)AtomicTorch.CBND.GameApi.WPF.dll" />
    <Reference Include="AtomicTorch.CBND.GameApi.WPF.Stubs" HintPath="$(GameApiRoot)AtomicTorch.CBND.GameApi.WPF.Stubs.dll" />
    <Reference Include="AtomicTorch.GameEngine.Common.Primitives" HintPath="$(GameApiRoot)AtomicTorch.GameEngine.Common.Primitives.dll" />
  </ItemGroup>

  <!-- Select mod files first, then Core files not overridden by the mod.
       Declare Compile/Page directly: copying private (_...) item types carries
       their item definitions into Visual Studio's cache, which cannot restore
       those private definitions when the solution is reopened. -->
  <ItemGroup>
    <Compile Include="$(ModRoot)**\*.cs" Exclude="$(ModRoot).*\**;$(ModRoot)bin\**;$(ModRoot)obj\**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Page Include="$(ModRoot)**\*.xaml" Exclude="$(ModRoot).*\**;$(ModRoot)bin\**;$(ModRoot)obj\**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Page>
    <Compile Include="$(CoreRoot)**\*.cs" Exclude="$(CoreRoot).*\**;$(CoreRoot)bin\**;$(CoreRoot)obj\**;@(Compile->'$(CoreRoot)%(Link)')">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Page Include="$(CoreRoot)**\*.xaml" Exclude="$(CoreRoot).*\**;$(CoreRoot)bin\**;$(CoreRoot)obj\**;@(Page->'$(CoreRoot)%(Link)')">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Page>
    <Content Include="Mod-Core-Review.html" />
    <None Include="Compare-Mod-Core.ps1" />
    <None Include="Validation.Xaml.targets" />
  </ItemGroup>

  <Target Name="CheckValidationInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(CoreRoot)AtomicTorch.CBND.CoreMod.csproj')" Text="Core.cpk must be installed beside HardcoreDesert." />
    <Error Condition="!Exists('$(GameApiRoot)AtomicTorch.CBND.GameApi.WPF.dll')" Text="CryoFall.Mod.Sdk/LibsGameApi must be installed beside HardcoreDesert." />
  </Target>

  <Import Project="Validation.Xaml.targets" />
</Project>
